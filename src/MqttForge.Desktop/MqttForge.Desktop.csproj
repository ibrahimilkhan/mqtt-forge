<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the subsystem is stamped into the apphost at build time, and a console
         one makes Windows open a console window before any managed code runs - so the app appears
         as two windows, the console instantly and the real one seconds later. Nothing in the
         program can take that back; by the time Main could call FreeConsole it has been seen.
         Console output goes nowhere on Windows as a result, which costs this app nothing: Serilog
         writes the log file, and a console session that wants the output runs `dotnet MQTTForge.dll`.
         Ignored on macOS and Linux, which have no subsystem field and never opened a terminal. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MQTTForge</AssemblyName>
    <RootNamespace>MqttForge.Desktop</RootNamespace>
    <!-- Stamped into the executable, which is where Windows reads an icon from: the file in
         Explorer, the button in the taskbar and the window's own corner all come from here.
         Ignored when the host being built is not a Windows one. -->
    <ApplicationIcon>Resources/MQTTForge.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Only the .png travels with the app: Linux is the one platform that has to be handed a
       path at runtime. The .ico is read here at build time and the .icns by the macOS packaging
       script, so neither is worth carrying into every build's output. -->
  <ItemGroup>
    <None Update="Resources/MQTTForge.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A console-SDK project hosting ASP.NET Core doesn't get this via the project reference, so it's declared explicitly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- Windows only, and only for the second and a half before the browser can draw: the window
         paints the splash's lockup itself until then (NativeLockup). Plain GDI draws the mark's
         diagonals and rounded corners without anti-aliasing, which would visibly sharpen into the
         browser's rendering at the hand-off; GDI+ draws them the way the browser does. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MqttForge.Api\MqttForge.Api.csproj" />
  </ItemGroup>

  <!-- This project runs from a different content root than MqttForge.Api, so its built interface has to be copied in explicitly. -->
  <!-- Api's Release build empties wwwroot and refills it with new hashes, so the glob must be resolved at execution time, not evaluation time. -->
  <Target Name="CopyFrontendAssets" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../MqttForge.Api/wwwroot')">
    <ItemGroup>
      <FrontendAsset Include="$(MSBuildProjectDirectory)/../MqttForge.Api/wwwroot/**" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" Condition="Exists('$(OutDir)wwwroot')" />
    <Copy SourceFiles="@(FrontendAsset)" DestinationFolder="$(OutDir)wwwroot/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Same resolve-at-execution-time reasoning applies to publish, which computes its file list on its own schedule. -->
  <Target Name="PublishFrontendAssets" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(MSBuildProjectDirectory)/../MqttForge.Api/wwwroot')">
    <RemoveDir Directories="$(PublishDir)wwwroot" Condition="Exists('$(PublishDir)wwwroot')" />
    <ItemGroup>
      <FrontendPublishAsset Include="$(MSBuildProjectDirectory)/../MqttForge.Api/wwwroot/**" />
      <ResolvedFileToPublish Include="@(FrontendPublishAsset->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
