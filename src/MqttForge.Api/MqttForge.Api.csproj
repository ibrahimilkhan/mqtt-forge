<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MqttForge.Application\MqttForge.Application.csproj" />
    <ProjectReference Include="..\MqttForge.Infrastructure\MqttForge.Infrastructure.csproj" />
    <ProjectReference Include="..\MqttForge.Domain\MqttForge.Domain.csproj" />
  </ItemGroup>

  <!-- What the build watches to decide the bundle is stale. node_modules and certs stay out. -->
  <ItemGroup>
    <FrontendSource Include="../../web/src/**;../../web/plugins/**;../../web/public/**" />
    <FrontendSource Include="../../web/index.html;../../web/vite.config.ts;../../web/tsconfig*.json" />
    <FrontendSource Include="../../web/package.json;../../web/package-lock.json" />
  </ItemGroup>

  <!-- Runs in every configuration, so a Debug run never serves yesterday's bundle. Inputs/Outputs
       make it a no-op while web/ is untouched, which is what kept it off Debug before;
       -p:SkipFrontend=true opts out entirely. -->
  <Target Name="BuildFrontend" BeforeTargets="Build"
          Condition="'$(SkipFrontend)' != 'true'"
          Inputs="@(FrontendSource)" Outputs="wwwroot/index.html">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../../web"
          Condition="!Exists('$(MSBuildProjectDirectory)/../../web/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../../web" />
  </Target>

  <!-- wwwroot doesn't exist at project evaluation time, so its files must be added explicitly here. -->
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <FrontendFile Include="wwwroot/**" />
      <ResolvedFileToPublish Include="@(FrontendFile->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(FrontendFile.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
