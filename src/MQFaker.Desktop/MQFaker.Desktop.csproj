<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MQFaker</AssemblyName>
    <RootNamespace>MQFaker.Desktop</RootNamespace>
  </PropertyGroup>

  <!-- A console-SDK project that hosts ASP.NET Core needs the framework reference stated
       outright; it does not arrive on its own through the project reference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MQFaker.Api\MQFaker.Api.csproj" />
  </ItemGroup>

  <!-- MQFaker.Api serves the interface via its own wwwroot, resolved against ITS content
       root. This project hosts that same code from a different content root (its own
       output directory), so the built interface has to be copied alongside it explicitly -
       referencing the Api project does not bring its wwwroot along on its own. -->
  <ItemGroup>
    <Content Include="..\MQFaker.Api\wwwroot\**">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
