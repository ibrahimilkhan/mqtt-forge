{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/MqttForge.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5169
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5170",
        "--directory",
        "src/MqttForge.Api/wwwroot"
      ],
      "port": 5170
    }
  ]
}
