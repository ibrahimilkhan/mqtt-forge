{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(python3:*)",
      "Bash(dotnet:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Edit",
      "Write",
      "Bash(ps -p 34902 -o pid,ppid,etime,command)",
      "Bash(git tag *)",
      "Bash(gh run *)",
      "Bash(gh release *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
